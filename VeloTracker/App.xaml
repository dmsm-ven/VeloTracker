<Application x:Class="VeloTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Startup="OnStartup" Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Loads WPF-UI control templates and the Fluent System Icons font. -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AccentBrush" Color="#2E7D5B" />
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F5" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#17211D" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#68756E" />
            <SolidColorBrush x:Key="WindowImageBrush" Color="#F4F6F5" />
            <SolidColorBrush x:Key="WindowOverlayBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="AlternateRowBrush" Color="#DFF8FAF8" />

            <Style TargetType="Button">
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="BorderBrush" Value="#D7DFDA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="7,5" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
