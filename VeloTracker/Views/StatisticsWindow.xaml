<ui:FluentWindow x:Class="VeloTracker.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Статистика VeloTracker" Width="760" Height="650" MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Статистика VeloTracker"/>
        <Grid Grid.Row="1" Margin="26">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Статистика" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Сводные данные по всем сохранённым событиям." Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ui:Card Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" Padding="18" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel><TextBlock Text="Пройденный километраж" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding TotalDistanceKm, StringFormat={}{0:N1} км}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Row="0" Grid.Column="1" Margin="10,0,0,10" Padding="18" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel><TextBlock Text="Количество поездок" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding RideCount}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" Padding="18" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel><TextBlock Text="Среднее время поездки" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding AverageRideMinutesLabel}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="По поездкам, где указано время" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Row="1" Grid.Column="1" Margin="10,0,0,10" Padding="18" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel><TextBlock Text="Средняя скорость" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding AverageSpeedLabel}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Расчёт только по поездкам с указанным временем" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" Padding="18" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel><TextBlock Text="Обслуживание" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding MaintenanceCount}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel><TextBlock Text="Детали и покупки" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding PartCount}" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding TotalPartCost, StringFormat=Сумма расходов: {0:N2}}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                    </ui:Card>
                </Grid>
            </ScrollViewer>
            <DockPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ui:Button DockPanel.Dock="Right" Content="Закрыть" Appearance="Secondary" IsCancel="True" Click="CloseButton_Click" Margin="12,0,0,0"/>
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
