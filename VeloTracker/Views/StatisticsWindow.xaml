<ui:FluentWindow x:Class="VeloTracker.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:VeloTracker.Controls"
        Title="Статистика VeloTracker" Width="1060" Height="900" MinHeight="680" MinWidth="780"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Статистика VeloTracker" />

        <Grid Grid.Row="1" Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2.1*" MinHeight="280" />
                <RowDefinition Height="1.2*" MinHeight="170" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Статистика" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Пробег по дням и сводные данные по сохранённым поездкам."
                           Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Width="180" MinHeight="34"
                              ItemsSource="{Binding PeriodOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Key"
                              SelectedValue="{Binding SelectedPeriodKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding PeriodDescription}"
                           VerticalAlignment="Center" Margin="16,0,2,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </DockPanel>

            <ui:Card Grid.Row="2" Padding="10" Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,12">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="HorizontalOnly">
                    <controls:BarChart Values="{Binding ChartValues}"
                                       Labels="{Binding ChartLabels}"
                                       ItemToolTips="{Binding ChartToolTips}"
                                       YAxisTitle="Километры"
                                       BarBrush="{DynamicResource AccentBrush}"
                                       TextBrush="{DynamicResource SecondaryTextBrush}"
                                       GridBrush="{DynamicResource DataGridHeaderBorderBrush}"
                                       Width="{Binding ChartWidth}"
                                       Height="320" />
                </ScrollViewer>
            </ui:Card>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:Card Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="14" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Пробег за всё время" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TotalDistanceKm, StringFormat={}{0:N1} км}" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Row="0" Grid.Column="1" Margin="4,0,4,8" Padding="14" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Количество поездок" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RideCount}" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Row="0" Grid.Column="2" Margin="8,0,0,8" Padding="14" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Среднее время поездки" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AverageRideMinutesLabel}" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Padding="14" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Средняя скорость" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AverageSpeedLabel}" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Row="1" Grid.Column="1" Margin="4,0,4,0" Padding="14" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Обслуживание" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MaintenanceCount}" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Padding="14" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Детали и покупки" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PartCount}" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding TotalPartCost, StringFormat=Расходы: {0:N2}}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="4" Margin="0,12,0,8">
                <TextBlock Text="Сводка за выбранный период" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="12" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Дней с поездками" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DaysWithRidesLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Grid.Column="1" Margin="4,0,4,0" Padding="12" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Суммарный пробег" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PeriodDistanceLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Grid.Column="2" Margin="8,0,0,0" Padding="12" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Среднее за поездку" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AverageDistancePerRideLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <DockPanel Grid.Row="6" Margin="0,12,0,0" LastChildFill="True">
                <ui:Button DockPanel.Dock="Right" Content="Закрыть" Appearance="Secondary" IsCancel="True" Margin="12,0,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
