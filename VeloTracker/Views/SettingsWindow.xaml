<ui:FluentWindow x:Class="VeloTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Настройки VeloTracker" Width="650" Height="690" MinHeight="580" WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Настройки VeloTracker" />
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Настройки" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="Изменения внешнего вида применяются сразу; «Отмена» восстановит прежние настройки." Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Тема" Margin="0,0,0,4"/>
                    <ComboBox Width="120" Margin="0,0,0,24" HorizontalAlignment="Left" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/>
                    <Separator Margin="0,0,0,18"/>
                    <TextBlock Text="Фоновое изображение" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Margin="0,0,8,0" Command="{Binding BrowseBackgroundCommand}" Content="Выбрать файл…"/>
                        <ui:Button Command="{Binding ClearBackgroundCommand}" Content="Убрать фон" Appearance="Secondary"/>
                    </StackPanel>
                    <CheckBox Content="Замостить изображение (для бесшовных текстур)" IsChecked="{Binding TileBackground}" Margin="0,0,0,8"/>
                    <StackPanel IsEnabled="{Binding TileBackground}" Margin="0,0,0,8">
                        <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding TextureScale, StringFormat=Масштаб текстуры: {0:0}%}"/>
                        <Slider Width="300" HorizontalAlignment="Left" Minimum="5" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding TextureScale}"/>
                    </StackPanel>
                    <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding OverlayOpacity, StringFormat=Непрозрачность изображения: {0:0}%}"/>
                    <Slider Width="300" Margin="0,0,0,8" HorizontalAlignment="Left" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding OverlayOpacity}"/>
                    <TextBlock Text="Цвет подложки" Margin="0,0,0,4"/>
                    <ComboBox Width="230" HorizontalAlignment="Left" ItemsSource="{Binding OverlayColors}" SelectedValuePath="Hex" SelectedValue="{Binding OverlayColor}" Margin="0,0,0,20">
                        <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="4" Background="{Binding Hex}" BorderBrush="{DynamicResource ComboBoxBorderBrush}" BorderThickness="1" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Настройки: %AppData%\VeloTracker. База событий: %LocalAppData%\VeloTracker." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,22,0,0" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="Отмена" Command="{Binding CancelCommand}" Appearance="Secondary" />
                <ui:Button Command="{Binding SaveCommand}" Appearance="Primary" Margin="0" IsDefault="True"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save24" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Сохранить" VerticalAlignment="Center"/></StackPanel></ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
