<ui:FluentWindow x:Class="VeloTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Настройки VeloTracker" Width="650" Height="690" MinHeight="580" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Настройки" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="Изменения внешнего вида применяются сразу; «Отмена» восстановит прежние настройки." Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Тема приложения" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Height="36" />
                    <Separator Margin="0,18" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><ui:SymbolIcon Symbol="Image24" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Фоновое изображение главного окна" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    <DockPanel>
                        <ui:Button Command="{Binding BrowseBackgroundCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" Appearance="Secondary"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Image24" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Выбрать…" VerticalAlignment="Center"/></StackPanel></ui:Button>
                        <ui:TextBox Text="{Binding BackgroundImagePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                    </DockPanel>
                    <TextBlock Text="Непрозрачность карточек поверх изображения" FontWeight="SemiBold" Margin="0,16,0,5" />
                    <DockPanel>
                        <TextBlock Text="{Binding OverlayOpacity, StringFormat={}{0}%}" DockPanel.Dock="Right" VerticalAlignment="Center" Width="55" TextAlignment="Right" />
                        <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding OverlayOpacity}" />
                    </DockPanel>
                    <TextBlock Text="Цвет карточек" FontWeight="SemiBold" Margin="0,14,0,5" />
                    <DockPanel LastChildFill="True">
                        <ui:Button Command="{Binding PickOverlayColorCommand}" DockPanel.Dock="Left" Margin="0,0,10,0" Padding="8,5" Appearance="Secondary">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Color24" Width="18" Height="18" Margin="0,0,6,0"/><TextBlock Text="Выбрать цвет…" VerticalAlignment="Center"/></StackPanel>
                        </ui:Button>
                        <Border Width="40" Height="32" BorderBrush="#808080" BorderThickness="1" CornerRadius="4" Background="{Binding OverlayColorPreview}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding OverlayColor}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </DockPanel>
                    <CheckBox Content="Замощать изображение (для бесшовных текстур)" IsChecked="{Binding TileBackground}" Margin="0,16,0,6" />
                    <TextBlock Text="Масштаб текстуры" FontWeight="SemiBold" Margin="0,8,0,5" />
                    <DockPanel>
                        <TextBlock Text="{Binding TextureScale, StringFormat={}{0}%}" DockPanel.Dock="Right" VerticalAlignment="Center" Width="55" TextAlignment="Right" />
                        <Slider Minimum="5" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" IsEnabled="{Binding TileBackground}" Value="{Binding TextureScale}" />
                    </DockPanel>
                    <TextBlock Text="Настройки: %AppData%\VeloTracker. База событий: %LocalAppData%\VeloTracker." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,22,0,0" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="Отмена" Command="{Binding CancelCommand}" Appearance="Secondary" />
                <ui:Button Command="{Binding SaveCommand}" Appearance="Primary" Margin="0" IsDefault="True"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save24" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Сохранить" VerticalAlignment="Center"/></StackPanel></ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
